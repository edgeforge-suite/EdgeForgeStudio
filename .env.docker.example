# Optional overrides for docker-compose.yml.
# Defaults assume EdgeForgeStudio, EdgeForge, and EdgeForgeKnowledgeServer are
# sibling directories under the same parent folder.

EDGEFORGE_ENGINE_REPO=../EdgeForge
EDGEFORGE_KS_REPO=../EdgeForgeKnowledgeServer

# Host-visible folder where Docker Studio writes generated packages/apps.
# The container still sees this as /workspace/data/GeneratedApps.
EDGEFORGE_STUDIO_GENERATED_APPS_DIR=/Users/<you>/Documents/EdgeForgeGeneratedApps

# Container-internal defaults used by fresh Studio sessions.
EDGEFORGE_STUDIO_DEFAULT_ENGINE_REPO=/workspace/EdgeForge
EDGEFORGE_STUDIO_DEFAULT_OUTPUT_PATH=/workspace/data/GeneratedApps

# Host interface the published port binds to. Defaults to 127.0.0.1: local
# mode has no auth (by design), so binding to every interface would expose an
# unauthenticated instance beyond this machine. Set to 0.0.0.0 only if you
# deliberately want it reachable from other devices on a trusted network.
EDGEFORGE_STUDIO_BIND_HOST=127.0.0.1

# UID/GID the container builds and runs as. The bind mounts above (source
# tree, Engine/KS checkouts, generated-apps output) keep the HOST's ownership
# regardless of anything set in the image, so match your own host user here
# if you hit permission errors on writes, e.g. via `id -u`/`id -g`.
EDGEFORGE_STUDIO_APP_UID=1000
EDGEFORGE_STUDIO_APP_GID=1000
